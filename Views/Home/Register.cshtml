<!-- Register Section-->
<section class="page-section" id="register">
    <div class="container">
        <!-- Register Section Heading-->
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Register</h2>
        <!-- Icon Divider-->
        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fa-solid fa-lock"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <!-- Register Section Form-->
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <form method="post" id="registerForm" >
                    <!-- Username input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" id="username" name="username" type="text" placeholder="Enter your username..." />
                        <label for="username">Username</label>
                    </div>
                    <!-- Password input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" id="email" name="email" type="email" placeholder="Enter your email..." />
                        <label for="password">Email Address</label>
                    </div>
                    <!-- Username input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" id="password" name="password" type="password" placeholder="Enter your password..." />
                        <label for="username">Password</label>
                    </div>
                    <!-- Password input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" id="confpassword" name="confpassword" type="password" placeholder="Confirm Password..." />
                        <label for="confpassword">Confirm Password</label>
                    </div>
                    <!-- Submit Button-->
                    <button class="btn btn-primary btn-xl" id="registerButton" type="submit">Register</button>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {
        $('#registerForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '/GetUser',
                type: 'POST',
                    data: {
                        username: $("#username").val(),
                        email: $("#email").val(),
                        password: $("#password").val(),
                        confPassword: $("#confpassword").val()
                    },
                success: function (response) {
                    alert(response);
                },
                error: function (xhr, status, error) {
                    alert("Error: " + error);
                }
            });
        });
    });
</script>
