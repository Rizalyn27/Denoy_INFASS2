@model IEnumerable<Denoy_INFASS2.ViewModels.UsersViewModel>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
    
    <table>
        <tr>
                <th> Username </th>
                <th> Email </th>
                <th> Password </th>
        </tr>

        <tr>
                @foreach (var user in Model)
                {
                <tr>
                    <td>
                        @Html.DisplayFor(m => user.Username)
                    </td>
                    <td>
                        @Html.DisplayFor(m => user.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(m => user.Password)
                    </td>
                </tr>
            }
        </tr>

    </table>

    </div>
</div>